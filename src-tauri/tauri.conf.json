{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Switchly",
  "version": "0.1.0",
  "identifier": "com.switchly.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Switchly",
        "width": 940,
        "height": 640,
        "minWidth": 780,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "backgroundColor": "#141319"
      },
      {
        "label": "popup",
        "title": "Switchly",
        "width": 340,
        "height": 460,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "backgroundColor": "#141319"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Laurenz19",
    "shortDescription": "Switch GitHub accounts per folder",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
