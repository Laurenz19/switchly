{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Switchly",
  "version": "0.3.1",
  "identifier": "com.switchly.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Switchly",
        "width": 940,
        "height": 640,
        "minWidth": 780,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "backgroundColor": "#141319",
        "maximizable": false
      },
      {
        "label": "popup",
        "title": "Switchly",
        "width": 340,
        "height": 300,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "backgroundColor": "#141319"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Laurenz19",
    "shortDescription": "Switch GitHub accounts per folder",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3RjcwRDhCNzQ0MEZEMTYKUldRVy9VQjBpdzMzWjFrMTBMTG1zMVZEdkZRNmgrVHVpeGY1N0pJU2djY2xNUlNKSUE3YTNjTmMK",
      "endpoints": [
        "https://github.com/Laurenz19/switchly/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
